<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Nearby Connections. It picks a transport at runtime (BLE / Bluetooth Classic /
         Wi-Fi Direct / Wi-Fi Aware), so all of them must be declared. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" tools:targetApi="s" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" tools:targetApi="tiramisu" />
    <!-- Below API 33 the Wi-Fi transports are location-gated (NEARBY_WIFI_DEVICES replaces this).
         32 rather than 30: nearbyPermissions() asks for FINE on 31-32, and an undeclared
         permission auto-denies, which silently kept sync from ever starting on Android 12/12L.
         COARSE must be declared and requested alongside FINE or Android 12+ ignores the request. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />

    <!-- Waking a phone whose app is closed: see Wake.kt. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- QR scanning to join an event. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bluecount">
        <!-- The label has to be on the activity too, not just the application: recents takes its
             title from the activity's own label and prints "com.bluecount.MainActivity" when it
             has none. -->
        <!-- windowSoftInputMode belongs on the activity: it is not one of the attributes an
             activity inherits from <application>, so declaring it up there did nothing at all and
             the keyboard panned the window instead of resizing it — which is why the bottom of the
             expense editor had nothing left to scroll. -->
        <!-- singleTask: a .bluecount file tapped in a chat app while Bluecount is already open
             must reach the running instance, not start a second one with its own back stack. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The two types worth claiming outright, for the providers that hand over a content
                 URI with no file name in it at all — WhatsApp gives
                 content://com.whatsapp.provider.media/item/66381, and MediaStore downloads and
                 Drive are the same shape. There is nothing in such a URI to match on, so every
                 pathPattern below is dead on arrival for them and only the type is left.

                 octet-stream is what MimeTypeMap returns for an extension it has never heard of,
                 i.e. ours. The price is that Bluecount is offered whenever anyone taps an untyped
                 binary, and can be made the default for them. Taken deliberately: not being
                 openable at all was worse. What makes it survivable is that ImportDialog answers a
                 wrong file with "That file isn't a Bluecount export" — that toast is load-bearing
                 now, not a nicety. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.bluecount" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- When the file name does survive, match on it whatever type the messenger invented.
                 */* costs nothing here: the pathPattern is what narrows this filter, not the type,
                 and unrelated files do not end in .bluecount.

                 Three patterns rather than one because Android's pathPattern `.*` is not greedy —
                 it stops at the first following match, so "Ski trip.v2.bluecount" needs its own.
                 ponytail: android:pathSuffix would be one line, but it is API 31 and minSdk is 26,
                 and below 31 it is *ignored* rather than failing, which here would widen the filter
                 to literally every file. Collapse these when minSdk reaches 31. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*"
                    android:pathPattern=".*\\.bluecount" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*"
                    android:pathPattern=".*\\..*\\.bluecount" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*"
                    android:pathPattern=".*\\..*\\..*\\.bluecount" />
                <data android:scheme="file" android:host="*" android:mimeType="*/*"
                    android:pathPattern=".*\\.bluecount" />
            </intent-filter>

            <!-- Second route in, for when "Open with" still fails or the messenger does not offer
                 it: the attachment's own Share button. application/* rather than */* keeps
                 Bluecount out of the share sheet for text, links, photos and video, while still
                 covering every way a file gets labelled. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".SyncService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Handing an export (CSV, key, .bluecount) to another app. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Exported: system broadcasts come from the system uid and never reach a private
             receiver. WakeReceiver guards on the action. -->
        <receiver
            android:name=".WakeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.bluetooth.adapter.action.STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
